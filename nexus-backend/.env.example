# NEXUS.IA Backend — Environment Variables
# Copy this file to .env and fill in your values

# ── App ──────────────────────────────────────────
APP_NAME=NEXUS.IA
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=change-me-to-a-very-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Database ─────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://nexus:nexus_secret@localhost:5432/nexus_db
DATABASE_URL_SYNC=postgresql+psycopg2://nexus:nexus_secret@localhost:5432/nexus_db

# ── Redis / Celery ───────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Qdrant ───────────────────────────────────────
QDRANT_URL=http://localhost:6333

# ── Ollama (IA local) ────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# ── Telegram ─────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ── WhatsApp (Evolution API) ─────────────────────
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_INSTANCE=

# ── Mercado Pago ─────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# ── Meta Ads ─────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=

# ── Encryption ───────────────────────────────────
CREDENTIALS_ENCRYPTION_KEY=change-me-to-32-byte-fernet-key==
